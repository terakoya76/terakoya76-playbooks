#!/usr/bin/env bash
# Moves the 1Password main window to the current workspace and focuses it,
# instead of letting GNOME jump to the workspace the window lives on.
# Window lookup/move/focus goes through the Window Calls GNOME Shell extension
# (https://github.com/ickyicky/window-calls), because Wayland forbids ordinary
# clients from doing so.
set -euo pipefail

readonly wm_class=com.onepassword.OnePassword

windows_call() {
  gdbus call --session \
    --dest org.gnome.Shell \
    --object-path /org/gnome/Shell/Extensions/Windows \
    --method "org.gnome.Shell.Extensions.Windows.$1" "${@:2}"
}

if ! list_json=$(windows_call List); then
  echo "Window Calls List failed; is the Window Calls GNOME Shell extension enabled?" >&2
  exit 1
fi

# gdbus wraps the returned string as ('...',).
if ! selection=$(python3 -c '
import ast, json, sys
windows = json.loads(ast.literal_eval(sys.argv[1])[0])
NORMAL_WINDOW = 0  # Meta.WindowType.NORMAL; Quick Access popups use other types
targets = [w["id"] for w in windows if w.get("wm_class") == sys.argv[2] and w.get("window_type") == NORMAL_WINDOW]
current = [w["workspace"] for w in windows if w.get("in_current_workspace") and w.get("workspace", -1) >= 0]
print(targets[0] if targets else "")
print(current[0] if current else "")
' "$list_json" "$wm_class"); then
  echo "Could not parse the Window Calls List reply; is the extension version supported?" >&2
  exit 1
fi
mapfile -t fields <<<"$selection"
win_id=${fields[0]:-}
current_ws=${fields[1]:-}

# With 1Password running in the tray (--silent) the main window is closed;
# invoking it again opens the window, and new windows map on the current
# workspace.
if [[ -z $win_id ]]; then
  exec 1password
fi

# Window Calls does not expose the active workspace index, so an empty
# workspace falls back to the EWMH property Mutter keeps on the Xwayland root.
if [[ -z $current_ws ]]; then
  current_ws=$(xprop -root _NET_CURRENT_DESKTOP | awk '{print $NF}')
fi

windows_call MoveToWorkspace "$win_id" "$current_ws" >/dev/null
# Activate also unminimizes the window.
windows_call Activate "$win_id" >/dev/null
